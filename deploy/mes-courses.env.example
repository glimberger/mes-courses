# Environment of the Mes courses server, read by deploy/mes-courses.service.
# Copy to /etc/mes-courses.env, fill in the values, then:
#   chown mes-courses:mes-courses /etc/mes-courses.env && chmod 600 /etc/mes-courses.env
# Never commit the filled-in file.

# DSN of the Sentry project mes-courses-server (EU region), not the app's.
# Empty: errors go to the journal only.
SENTRY_DSN=

# SQLite database path. Empty: /var/lib/mes-courses/mes-courses.db.
MES_COURSES_DB=

# Mail: invitations and password resets (the relay sees addresses and temporary passwords).
# All three are required on the Pi; the service refuses to start without them. Names only here.
# SMTP relay, smtp://user:password@host:587 (STARTTLS).
MES_COURSES_SMTP_URL=
# Sender, for example "Mes courses <courses@example.org>".
MES_COURSES_MAIL_FROM=
# Public address of the server, written in the emails, for example https://courses.example.org.
MES_COURSES_PUBLIC_URL=

# The public domain is not set here: Caddy reads MES_COURSES_DOMAIN from its own environment
# (see deploy/Caddyfile).
