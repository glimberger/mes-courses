# Environment of one instance of the Mes courses server, read by deploy/mes-courses@.service.
# Copy to /etc/mes-courses/production.env and /etc/mes-courses/staging.env, fill in the values,
# then, for each <env>:
#   chown mes-courses-<env>:mes-courses-<env> /etc/mes-courses/<env>.env
#   chmod 600 /etc/mes-courses/<env>.env
# Never commit the filled-in files.

# The environment this instance is: production or staging. It names the Sentry environment.
MES_COURSES_ENV=
# The port Caddy proxies to: 3000 for production, 3002 for staging. While the agent validates a
# new version it overrides this with 3100 or 3101 (see /run/mes-courses/<env>.env).
MES_COURSES_PORT=

# DSN of the Sentry project mes-courses-server (EU region), not the app's.
# Empty: errors go to the journal only.
SENTRY_DSN=

# The database path is not set here: the unit puts it in /var/lib/mes-courses/<env>/.

# Mail: invitations and password resets (the relay sees addresses and temporary passwords).
# All three are required on the Pi; the service refuses to start without them. Names only here.
# SMTP relay, smtp://user:password@host:587 (STARTTLS).
MES_COURSES_SMTP_URL=
# Sender, for example "Mes courses <courses@example.org>".
MES_COURSES_MAIL_FROM=
# Public address of the server, written in the emails, for example https://courses.example.org.
MES_COURSES_PUBLIC_URL=

# The public domain is not set here: Caddy reads MES_COURSES_DOMAIN from its own environment
# (see deploy/Caddyfile).
