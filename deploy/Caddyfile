# Public entry of the Mes courses servers on the Pi (research R4, R8, R12, R17).
#
# These are the blocks of Mes courses, to ADD to the live /etc/caddy/Caddyfile, not a file to copy
# over it: on the Pi it also serves other projects (see hosts/agent-pi/PORTS.md in nix-config).
# Write the two domains in full in place of `{$MES_COURSES_DOMAIN}` (production) and
# `{$MES_COURSES_STAGING_DOMAIN}` (staging), for example `courses.example.org` and
# `staging.courses.example.org`; the variables are only a way to keep this file free of the
# owner's domains. Then `caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile` and
# `systemctl reload caddy`.
#
# Naming a domain turns on automatic HTTPS: Caddy gets a Let's Encrypt certificate (ports 80 and
# 443 must reach the Pi) and redirects HTTP to HTTPS. The servers listen on 127.0.0.1 only. Each
# site also serves its F-Droid repository, generated in CI and unpacked by the agent, under
# /fdroid/repo.
{$MES_COURSES_DOMAIN} {
	encode gzip
	handle_path /fdroid/* {
		root * /srv/fdroid/production/current
		file_server
	}
	reverse_proxy 127.0.0.1:3000
}

{$MES_COURSES_STAGING_DOMAIN} {
	encode gzip
	handle_path /fdroid/* {
		root * /srv/fdroid/staging/current
		file_server
	}
	reverse_proxy 127.0.0.1:3002
}
