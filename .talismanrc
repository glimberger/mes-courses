# SQL "PRIMARY KEY" declarations trip the pattern detector; they are not secrets.
allowed_patterns:
  - 'PRIMARY KEY'
fileignoreconfig:
  # flake.lock pins Nix inputs with content hashes and git revisions, not secrets.
  - filename: flake.lock
    ignore_detectors: [filecontent]
  # direnv's file is named .envrc by convention; it holds `use flake`, not secrets.
  - filename: .envrc
    ignore_detectors: [filename]
  # The ESLint selectors name the `key` field of an AST property node, which trips the pattern detector.
  - filename: eslint.config.mjs
    ignore_detectors: [filecontent]
  # Yarn lockfiles hold package checksums, not secrets.
  - filename: yarn.lock
    ignore_detectors: [filecontent]
  # Spec Kit manifests record SHA-256 content hashes of generated files, not secrets.
  - filename: .specify/integrations/speckit.manifest.json
    ignore_detectors: [filecontent]
  - filename: .specify/integrations/claude.manifest.json
    ignore_detectors: [filecontent]
  - filename: .specify/memory/.constitution-template.json
    ignore_detectors: [filecontent]
  # Generated by the Specify CLI: words like "pass", "key" and "auth" trip the pattern detector.
  - filename: .specify/templates/spec-template.md
    ignore_detectors: [filecontent]
  - filename: .specify/scripts/bash/common.sh
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-analyze/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-checklist/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-clarify/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-implement/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-specify/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-taskstoissues/SKILL.md
    ignore_detectors: [filecontent]
version: "1.0"
