# SQL "PRIMARY KEY" declarations trip the pattern detector; they are not secrets.
allowed_patterns:
  - 'PRIMARY KEY'
  # A node:sqlite option name (DatabaseSync), not a secret.
  - 'enableForeignKeyConstraints'
  # The SQLite pragma that turns foreign constraints on, not a secret.
  - 'PRAGMA foreign_keys'
  # React's `key` prop on a JSX element, which sets its identity, not a secret.
  - 'key=\{'
  # TypeScript's `keyof` operator, which names a type's properties, not a secret.
  - 'keyof'
  # A React Native ScrollView prop (taps reach the list while typing), not a secret.
  - 'keyboardShouldPersistTaps'
  # An expo-secure-store option naming when the keychain entry is readable, not a secret.
  - 'WHEN_UNLOCKED_THIS_DEVICE_ONLY'
  # expo-secure-store option naming when a keychain entry is readable, not a secret.
  - 'keychainAccessible'
fileignoreconfig:
  # flake.lock pins Nix inputs with content hashes and git revisions, not secrets.
  - filename: flake.lock
    ignore_detectors: [filecontent]
  # direnv's file is named .envrc by convention; it holds `use flake`, not secrets.
  - filename: .envrc
    ignore_detectors: [filename]
  # The ESLint selectors name the `key` field of an AST property node, which trips the pattern detector.
  - filename: eslint.config.mjs
    ignore_detectors: [filecontent]
  # Gradle properties are `{ type, key, value }` items in Expo's config plugin API, which trips the
  # pattern detector.
  - filename: apps/mobile/build-config/android-no-minify.cjs
    ignore_detectors: [filecontent]
  - filename: apps/mobile/build-config/android-no-minify.test.ts
    ignore_detectors: [filecontent]
  # `key` and `restore-keys` are the cache inputs of actions/cache, not secrets.
  - filename: .github/workflows/ci.yml
    ignore_detectors: [filecontent]
  - filename: .github/workflows/e2e.yml
    ignore_detectors: [filecontent]
  # Yarn lockfiles hold package checksums, not secrets.
  - filename: yarn.lock
    ignore_detectors: [filecontent]
  # A Yarn patch's diff headers carry Git blob hashes, not secrets.
  - filename: .yarn/patches/react-native-paper-npm-5.15.3-9a600de527.patch
    ignore_detectors: [filecontent]
  - filename: .yarn/patches/detox-npm-20.51.4-f0776917eb.patch
    ignore_detectors: [filecontent]
  # Spec Kit manifests record SHA-256 content hashes of generated files, not secrets.
  - filename: .specify/integrations/speckit.manifest.json
    ignore_detectors: [filecontent]
  - filename: .specify/integrations/claude.manifest.json
    ignore_detectors: [filecontent]
  - filename: .specify/memory/.constitution-template.json
    ignore_detectors: [filecontent]
  # Generated by the Specify CLI: words like "pass", "key" and "auth" trip the pattern detector.
  - filename: .specify/templates/spec-template.md
    ignore_detectors: [filecontent]
  - filename: .specify/scripts/bash/common.sh
    ignore_detectors: [filecontent]
  # Feature 004 is about passwords, keys and sessions: its prose trips the pattern detector, and it
  # holds no secret.
  - filename: docs/adr/0005-accounts-and-authentication.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/checklists/requirements.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/checklists/security.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/contracts/app-ports.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/contracts/auth-api.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/contracts/ui-screens.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/data-model.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/plan.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/quickstart.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/research.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/spec.md
    ignore_detectors: [filecontent]
  - filename: specs/004-multi-user/tasks.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-analyze/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-checklist/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-clarify/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-implement/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-specify/SKILL.md
    ignore_detectors: [filecontent]
  - filename: .claude/skills/speckit-taskstoissues/SKILL.md
    ignore_detectors: [filecontent]
  # The file name check flags any name containing "sql" (database dumps); these are SQLite adapter
  # sources named by the tasks, not dumps.
  - filename: apps/mobile/src/adapters/sqlite/sql-database.ts
    ignore_detectors: [filename]
  - filename: apps/mobile/src/adapters/sqlite/sqlite-repositories.test.ts
    ignore_detectors: [filename]
  - filename: apps/mobile/test/sqlite/node-sql-database.ts
    ignore_detectors: [filename]
  - filename: apps/server/src/adapters/sqlite/sql-database.ts
    ignore_detectors: [filename]
  - filename: apps/server/src/adapters/sqlite/sqlite-store.ts
    ignore_detectors: [filename, filecontent]
  - filename: apps/server/src/adapters/sqlite/sqlite-store.test.ts
    ignore_detectors: [filename]
  # The crypto test asserts the published SHA-256 vectors, and the pairing-code alphabet is a
  # fixed character set (no 0/O/1/I); neither is a secret.
  - filename: apps/server/src/adapters/crypto/crypto.test.ts
    ignore_detectors: [filecontent]
  - filename: apps/server/src/adapters/crypto/crypto.ts
    ignore_detectors: [filecontent]
  # `itemKey(listId, articleId)` builds a Map key for a list item, which trips the pattern detector.
  - filename: apps/server/src/application/testing/in-memory-store.ts
    ignore_detectors: [filecontent]
  # Pending-field keys (`kind:id:field`), list item keys (`listId:articleId`) and the words
  # "credentials"/"pending ... key" in comments trip the pattern detector; none is a secret.
  - filename: apps/mobile/src/application/use-cases/synchronize.ts
    ignore_detectors: [filecontent]
  - filename: apps/mobile/src/application/use-cases/synchronize.test.ts
    ignore_detectors: [filecontent]
  - filename: apps/mobile/src/adapters/sqlite/pulled-rows-applier.ts
    ignore_detectors: [filecontent]
  - filename: apps/mobile/src/adapters/sqlite/pulled-rows-applier.test.ts
    ignore_detectors: [filecontent]
  - filename: apps/mobile/test/app-stack.ts
    ignore_detectors: [filecontent]
  - filename: apps/server/src/application/use-cases/apply-with-merge.ts
    ignore_detectors: [filecontent]
  # The environment template for the Pi holds variable names only, no values.
  - filename: deploy/mes-courses.env.example
    ignore_detectors: [filename]
  # Feature 004 phase 2: account, password-hash and attempt-key code. Column and field names such
  # as password_hash or keyHash trip the pattern detector; no file holds a secret.
  - filename: .dependency-cruiser.cjs
    ignore_detectors: [filecontent]
  - filename: apps/server/package.json
    ignore_detectors: [filecontent]
  - filename: apps/server/src/adapters/crypto/password-hasher.test.ts
