{
  "name": "@mes-courses/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "e2e:build:android": "detox build -c android.emu.release",
    "e2e:test:android": "detox test -c android.emu.release",
    "e2e:build:ios": "detox build -c ios.sim.release",
    "e2e:test:ios": "detox test -c ios.sim.release",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.unit.config.js",
    "e2e:build:ios:shots": "detox build -c ios.sim.shots",
    "e2e:build:android:shots": "detox build -c android.emu.shots",
    "e2e:shots:ios": "SHOTS=1 detox test -c ios.sim.shots",
    "e2e:shots:android": "SHOTS=1 detox test -c android.emu.shots"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24",
    "detox": "20.51.4",
    "jest": "^30",
    "ts-jest": "^29",
    "typescript": "~6.0.3"
  }
}
