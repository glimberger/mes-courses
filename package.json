{
  "name": "mes-courses",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "yarn workspaces foreach --all --exclude mes-courses run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "yarn workspaces foreach --all --exclude mes-courses run typecheck",
    "test:architecture": "depcruise apps --config .dependency-cruiser.cjs",
    "build": "yarn workspaces foreach --all --exclude mes-courses run build"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.13.0",
    "prettier": "^3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
