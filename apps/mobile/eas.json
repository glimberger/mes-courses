{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "node": "24.21.0"
    },
    "staging": {
      "distribution": "internal",
      "environment": "staging",
      "autoIncrement": true,
      "node": "24.21.0",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENVIRONMENT": "staging"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "node": "24.21.0",
      "env": {
        "EXPO_PUBLIC_APP_ENVIRONMENT": "production"
      }
    }
  }
}
