    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mes-courses/sync-core": "workspace:*",
    "@sentry/node": "^11.5.0",
    "fastify": "5"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24",
    "jest": "^30",
    "ts-jest": "^29",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
